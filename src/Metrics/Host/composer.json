{
  "name": "open-telemetry/opentelemetry-host-metrics",
  "description": "OpenTelemetry host metrics for PHP - collects CPU, Memory, and Network metrics",
  "keywords": ["opentelemetry", "otel", "open-telemetry", "metrics", "host", "cpu", "memory", "network"],
  "type": "library",
  "homepage": "https://opentelemetry.io/docs/languages/php/",
  "readme": "./README.md",
  "license": "Apache-2.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "open-telemetry/api": "^1.1",
    "open-telemetry/sdk": "^1.0",
    "open-telemetry/sem-conv": "^1.32",
    "symfony/http-client": "^8.0",
    "nyholm/psr7": "^1.8"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3",
    "phan/phan": "^5.0",
    "phpstan/phpstan": "^1.1",
    "phpstan/phpstan-phpunit": "^1.0",
    "psalm/plugin-phpunit": "^0.19.2",
    "phpunit/phpunit": "^9.5",
    "vimeo/psalm": "6.4.0"
  },
  "autoload": {
    "psr-4": {
      "OpenTelemetry\\Contrib\\Metrics\\Host\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenTelemetry\\Tests\\Contrib\\Metrics\\Host\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "tbachert/spi": true
    }
  }
}
